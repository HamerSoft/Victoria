/* Victoria Dark Theme — matches Unity Pro Editor skin */

:root {
    --bg-base:          rgb(60, 60, 60);
    --bg-panel:         rgb(56, 56, 56);
    --bg-darker:        rgb(40, 40, 40);
    --bg-input:         rgb(42, 42, 42);
    --bg-popup:         rgb(94, 94, 94);
    --bg-header:        rgba(30, 30, 30, 0.4);

    --border:           rgb(26, 26, 26);
    --border-input:     rgb(35, 35, 35);

    --text:             rgb(212, 212, 212);
    --text-dim:         rgb(160, 160, 160);

    --accent:           rgb(61, 139, 255);
    --accent-border:    rgb(44, 100, 190);

    --hover-tint:       rgba(255, 255, 255, 0.08);
    --focus-tint:       rgba(60, 140, 255, 0.25);
    --selected-tint:    rgba(60, 140, 255, 0.25);
}

/* ---- Base ---- */

VisualElement {
    color: var(--text);
}

Label {
    color: var(--text);
}

/* ---- Buttons ---- */

Button {
    background-color: rgb(70, 70, 70);
    color: var(--text);
    border-color: var(--border-input);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
}

Button:hover {
    background-color: rgb(88, 88, 88);
}

Button:active {
    background-color: rgb(42, 42, 42);
}

Button:focus {
    border-color: var(--accent);
}

/* ---- TextField ---- */

.unity-base-text-field__input {
    background-color: var(--bg-input);
    color: var(--text);
    border-color: var(--border-input);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.unity-base-text-field__input:focus {
    border-color: var(--accent);
}

/* ---- Toggle ---- */

.unity-toggle__checkmark {
    background-color: var(--bg-input);
    border-color: var(--border-input);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    -unity-background-image-tint-color: var(--text);
}

.unity-toggle__input:checked .unity-toggle__checkmark {
    background-color: var(--accent);
    border-color: var(--accent-border);
}

.unity-toggle__input:focus .unity-toggle__checkmark {
    border-color: var(--accent);
}

/* ---- ScrollView ---- */

.unity-scroll-view {
    background-color: var(--bg-panel);
}

.unity-scroller {
    background-color: rgb(49, 49, 49);
}

.unity-scroller--vertical {
    width: 13px;
}

.unity-scroller--horizontal {
    height: 13px;
}

.unity-base-slider__tracker {
    background-color: rgb(45, 45, 45);
}

.unity-base-slider__dragger {
    background-color: rgb(90, 90, 90);
    border-color: var(--border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    min-height: 30px;
    min-width: 10px;
}

.unity-base-slider__dragger:hover {
    background-color: rgb(110, 110, 110);
}

/* ---- ListView ---- */

.unity-list-view {
    background-color: var(--bg-panel);
}

.unity-list-view__item {
    background-color: rgba(0, 0, 0, 0);
    color: var(--text);
}

.unity-list-view__item:hover {
    background-color: var(--hover-tint);
}

.unity-list-view__item--selected {
    background-color: var(--selected-tint);
}

.unity-list-view__item--selected:hover {
    background-color: var(--selected-tint);
}

/* ---- TwoPaneSplitView ---- */

.unity-two-pane-split-view__drag-line-anchor {
    background-color: var(--border);
}

.unity-two-pane-split-view__drag-line {
    background-color: var(--border);
    width: 3px;
    height: 3px;
}

/* ---- Named elements ---- */

#package-overview {
    background-color: var(--bg-panel);
    border-right-color: var(--border);
    border-right-width: 1px;
}

#destination {
    background-color: var(--bg-panel);
}

#destination_header {
    background-color: var(--bg-darker);
    border-bottom-color: var(--border);
    border-bottom-width: 1px;
}

#import-button {
    min-width: 60px;
}

#import_label {
    color: var(--text-dim);
}

#audio-header {
    background-color: var(--bg-darker);
    border-bottom-color: var(--border);
    border-bottom-width: 1px;
}

#audio-file-name {
    color: var(--text);
}

#audio-play-button {
    width: 24px;
    height: 24px;
    font-size: 11px;
}

#searchbar-label {
    color: var(--text);
}